# --- Comandos reales de este repositorio (framework bash/python) ---
KZ_TEST_CMD="bash tests/run.sh"
KZ_LINT_CMD="bash -n scripts/kaizen scripts/kaizen-security scripts/kaizen-loop scripts/kaizen-swarm scripts/bootstrap scripts/lib/swarm-common.sh tests/run.sh .githooks/commit-msg .githooks/pre-commit .githooks/pre-push && python3 -m py_compile scripts/kaizen-insights.py"
KZ_FMT_CMD="git diff --check"
# Comandos que imprimen SOLO un numero. Vacio = no se mide.
KZ_COVERAGE_CMD=""
KZ_WARNINGS_CMD=""

# --- Generales ---
KZ_DEFAULT_BRANCH="main"
KZ_DRAFTS_DIR="docs/kaizen/pr-drafts"
KZ_SRC_GLOBS="scripts tests"

# --- POLITICAS (1 = activa, 0 = desactivada) ---
KZ_POLICY_COMMIT_MAX=256
KZ_POLICY_NO_EMOJI=0
KZ_POLICY_NO_AI_ATTRIBUTION=0
KZ_POLICY_BRANCH_PREFIXES_BLOCKED=""
