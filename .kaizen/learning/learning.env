# Aprendizaje continuo de los agentes (ADR-0007).
KL_DIR=".kaizen/learning"
KL_LESSONS="$KL_DIR/lessons"
KL_EXPERIENCE="$KL_DIR/experience"
KL_MAX_LESSONS=20          # tope de lecciones por digest de agente
KL_AUTO_RECORD=1           # el runtime registra fallos automáticamente
KL_AUTO_APPLY=0            # aplicar lecciones a la definición requiere decisión humana/ADR
KL_MIN_RECURRENCE=2        # lecciones repetidas antes de promover a regla
