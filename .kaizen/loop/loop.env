# Agente: claude | codex | opencode | agy | custom
KL_AGENT="opencode"
# Nivel 3 aprobado por ADR-0001 (decision humana, sesion de instalacion).
KL_AUTONOMY=3

KL_LOOPS="dev ops sweep research product"
KL_INTERVAL_SEC=10800
KL_MAX_TURNS=40
KL_TIMEOUT_SEC=1800
KL_MAX_RUNS_PER_DAY=8
KL_MAX_CONSEC_FAILS=3
KL_SETUP_CMD=""

KL_CLAUDE_ALLOWED="Read,Edit,Write,Glob,Grep,Bash(git add:*),Bash(git commit:*),Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(scripts/kaizen:*)"
KL_CUSTOM_CMD=""

# Rutas protegidas: NUNCA auto-merge, siempre needs-human.
KL_PROTECTED_GLOBS=".github/* .githooks/* .kaizen/* scripts/kaizen* scripts/lib/* scripts/bootstrap docs/kaizen/loop/* docs/kaizen/swarm/* CODEOWNERS AGENTS.md CLAUDE.md GEMINI.md opencode.json .claude/* .agents/* .opencode/* *auth* *billing* *payment* *secret* *.env* migrations/* infra/* terraform/* Dockerfile*"
KL_LOWRISK_GLOBS="docs/* *.md"
KL_TEST_GLOBS="tests/* test/* *_test.* *.test.* *.spec.* *_spec.*"
KL_LOWRISK_MAX_LINES=150
# Variables extra del agente. NUNCA GH_TOKEN ni secretos de despliegue.
KL_AGENT_ENV_PASS=""
