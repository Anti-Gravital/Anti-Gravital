# Organizacion de agentes: inventario configurable, proactividad y consenso.
KO_ORG_NAME="Kaizen Swarm Organization"
KO_REGISTRY=".kaizen/org/registry.json"
KO_PROMPTS_DIR=".kaizen/org/prompts"
KO_DECISIONS_DIR=".kaizen/org/decisions"
KO_KNOWLEDGE_DIR=".kaizen/org/knowledge"

# Proactividad: los agentes pueden proponer trabajo sin esperar una orden.
KO_PROACTIVITY=1
KO_PULSE_MAX_PER_AGENT=3        # tope de propuestas proactivas por agente y pulso
KO_PULSE_INTERVAL_SEC=1800
KO_PROACTIVE_LABEL="swarm:proactive"
KO_CONSENSUS_TURNS=2            # regla de los 2 turnos antes de escalar al gerente
KO_CONSENSUS_THRESHOLD=0.66     # mayoria cualificada para decisiones sin veto
KO_DECISION_REVIEW_DAYS=14      # revision de decisiones (PDCA / L-9)
KO_PAUSE_FILE=".kaizen/loop/PAUSE"
