# --- Concurrencia y rondas ---
KSW_MAX_PARALLEL="${KSW_MAX_PARALLEL:-6}"
KSW_MAX_ROUNDS="${KSW_MAX_ROUNDS:-3}"
KSW_ISSUE_BRANCH_PREFIX="${KSW_ISSUE_BRANCH_PREFIX:-kaizen/issue}"
KSW_WORKTREE_PREFIX="${KSW_WORKTREE_PREFIX:-wt-issue}"

# --- Herramienta local por rol: claude | codex | opencode | agy ---
# Coordinador por defecto: opencode (todas las CLIs estan instaladas).
KSW_ROLE_AGENT_ARCHITECT="${KSW_ROLE_AGENT_ARCHITECT:-opencode}"
KSW_ROLE_AGENT_DEV="${KSW_ROLE_AGENT_DEV:-opencode}"
KSW_ROLE_AGENT_QA="${KSW_ROLE_AGENT_QA:-opencode}"
KSW_ROLE_AGENT_SECURITY="${KSW_ROLE_AGENT_SECURITY:-opencode}"
KSW_ROLE_AGENT_DEFAULT="${KSW_ROLE_AGENT_DEFAULT:-opencode}"

# --- Buzón hibrido ---
# 0 = mailbox/ ignorado por git (+ export saneado al descriptor en finalize)
# 1 = buzón versionado completo en el PR
KSW_MAILBOX_VERSIONED="${KSW_MAILBOX_VERSIONED:-0}"

# --- Trazabilidad y consenso ---
KSW_ACK_REQUIRED="${KSW_ACK_REQUIRED:-1}"             # un handoff no cierra sin mensaje ack
KSW_DISAGREEMENT_TURNS="${KSW_DISAGREEMENT_TURNS:-2}" # regla de los 2 turnos antes de needs-human
KSW_LEASE_TTL_SEC="${KSW_LEASE_TTL_SEC:-1800}"        # lease de subtarea antes de reaper
KSW_WATCH_LABEL="${KSW_WATCH_LABEL:-swarm:ready}"     # etiqueta que dispara la init autonoma
KSW_WATCH_INTERVAL_SEC="${KSW_WATCH_INTERVAL_SEC:-600}"

# --- Puertas ---
KSW_REQUIRE_GATES="${KSW_REQUIRE_GATES:-1}"           # finalize exige kaizen check + kaizen-security check
KSW_DRY_RUN="${KSW_DRY_RUN:-0}"                       # 1 = imprime el plan sin efectos (verificacion)
