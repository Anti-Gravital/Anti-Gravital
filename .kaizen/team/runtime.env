# Runtime proactivo de equipos de agentes.
KR_AGENT_CMD="opencode"
KR_INTERVAL_SEC=900
KR_MAX_RUNS_PER_DAY=24
KR_TIMEOUT_SEC=900
KR_DRY_RUN=0
# Recursión controlada: los agentes pueden delegar en otros (proactividad),
# incrementando KAZEN_AGENT_DEPTH. Al llegar al tope, reportan en vez de delegar.
KR_MAX_DEPTH=3
# Equipos simultáneos (cada equipo con sus propios agentes en paralelo).
KR_MAX_TEAMS_PARALLEL=4
KR_PAUSE_FILE=".kaizen/loop/PAUSE"
KR_STATE_DIR=".kaizen/team/runtime"
KR_TEAMS_FILE=".kaizen/team/teams.json"
