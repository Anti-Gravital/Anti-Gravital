# Copy to .env next to this file and fill real values at deploy time.
# Never commit a populated .env. No secret is stored in the repository.

# Required: database password for the API family.
POSTGRES_PASSWORD=CHANGE_ME
# Optional overrides with safe local defaults.
POSTGRES_USER=postgres
POSTGRES_DB=todos
API_PORT=8080
WEB_PORT=3000
REALTIME_PORT=3000
AI_PORT=3001

# Required: API key for the AI family. Use any non-empty value for a local
# compatible endpoint and set AI_BASE_URL below.
AI_API_KEY=CHANGE_ME
AI_BASE_URL=

# Optional: generated project package/binary overrides per family.
WEB_PACKAGE=realtime-chat
WEB_BINARY=realtime-chat
API_PACKAGE=todo-api
API_BINARY=todo-api
REALTIME_PACKAGE=realtime-chat
REALTIME_BINARY=realtime-chat
INFRA_PACKAGE=workers-basic
INFRA_BINARY=workers-basic
AI_PACKAGE=ai-backend
AI_BINARY=ai-backend
