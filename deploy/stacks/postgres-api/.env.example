# Copy to .env and adjust. .env is gitignored; never commit real credentials.
# These values are local-only placeholders for development.
POSTGRES_USER=ag
POSTGRES_PASSWORD=ag-local-only
POSTGRES_DB=ag
POSTGRES_PORT=5432

# Optional app service (profile "app"). API_BUILD_CONTEXT is the directory of
# a generated project that contains API_DOCKERFILE.
API_PORT=8080
API_BUILD_CONTEXT=.
API_DOCKERFILE=Dockerfile
API_IMAGE=ag-api:local
