{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anti-gravital.dev/mcp/cli-json-0.2.0.schema.json",
  "title": "Anti-Gravital CLI versioned JSON output",
  "description": "Shape of `ag --output json` for read-only commands. RFC-0021 section 4.3, RFC-0020 (env), RFC-0033 (domain loop), RFC-0034 (local deploy) and RFC-0018 (config). Pre-0.5 contract: unstable; an incompatible shape change bumps contract_version. The config.get, env.list and env.check shapes are additive and defined in this version; see the contract document for their CLI dispatch status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "command",
    "status"
  ],
  "properties": {
    "contract_version": {
      "const": "0.2.0"
    },
    "command": {
      "enum": [
        "schema.lint",
        "schema.diff",
        "workers.list",
        "deploy.plan",
        "deploy.status",
        "unknown",
        "dns.plan",
        "dns.status",
        "config.get",
        "env.list",
        "env.check"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/schemaLintData"
        },
        {
          "$ref": "#/$defs/schemaDiffData"
        },
        {
          "$ref": "#/$defs/workersListData"
        },
        {
          "$ref": "#/$defs/deployPlanData"
        },
        {
          "$ref": "#/$defs/deployStatusData"
        },
        {
          "$ref": "#/$defs/dnsPlanData"
        },
        {
          "$ref": "#/$defs/dnsStatusData"
        },
        {
          "$ref": "#/$defs/configGetData"
        },
        {
          "$ref": "#/$defs/envListData"
        },
        {
          "$ref": "#/$defs/envCheckData"
        }
      ]
    },
    "error": {
      "$ref": "#/$defs/errorBody"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "data"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "unsupported_command",
            "read_failed"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "diagnosticView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "message",
        "hint",
        "span_start",
        "span_end"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schemaLintData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "result",
        "error_count",
        "warning_count",
        "diagnostics"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "clean",
            "warnings",
            "errors"
          ]
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticView"
          }
        }
      }
    },
    "schemaChangeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "breaking",
            "additive"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "schemaDiffData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "schema",
        "changes"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaChangeView"
          }
        }
      }
    },
    "workerView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "queue",
        "mode",
        "concurrency",
        "input",
        "retry_max_attempts"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "queue": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry_max_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "workersListData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "workers"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "workers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workerView"
          }
        }
      }
    },
    "deployFileView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source",
        "bytes",
        "fingerprint"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      }
    },
    "deployPlanData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "project",
        "plan_id",
        "files"
      ],
      "properties": {
        "target": {
          "enum": [
            "docker",
            "k8s"
          ]
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "plan_id": {
          "type": "string",
          "pattern": "^dpl-(docker|k8s)-[0-9a-f]{16}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployFileView"
          }
        }
      }
    },
    "deployStatusData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated",
        "target",
        "plan_id",
        "project",
        "files",
        "current_plan_id",
        "in_sync",
        "sources_available"
      ],
      "properties": {
        "generated": {
          "type": "boolean"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "docker",
            "k8s",
            null
          ]
        },
        "plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_sync": {
          "type": "boolean"
        },
        "sources_available": {
          "type": "boolean"
        }
      }
    },
    "dnsRecordView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "name",
        "value",
        "ttl",
        "is_ownership"
      ],
      "properties": {
        "record_type": {
          "enum": [
            "A",
            "AAAA",
            "CNAME",
            "TXT",
            "MX"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "ttl": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "is_ownership": {
          "type": "boolean"
        }
      }
    },
    "dnsPlanData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "domain",
        "zone",
        "environment",
        "visibility",
        "project",
        "service",
        "target_kind",
        "tls",
        "records",
        "notes"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^dns-(dev|staging|production|local)-[0-9a-f]{16}$"
        },
        "domain": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "staging",
            "production",
            "local"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "enum": [
            "service"
          ]
        },
        "tls": {
          "enum": [
            "disabled",
            "managed_http01",
            "managed_dns01"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dnsRecordView"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dnsStatusData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "applied",
        "plan_id",
        "domain",
        "visibility",
        "provider",
        "record_count",
        "in_sync"
      ],
      "properties": {
        "environment": {
          "enum": [
            "dev",
            "staging",
            "production",
            "local"
          ]
        },
        "applied": {
          "type": "boolean"
        },
        "plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            null
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "in_sync": {
          "type": "boolean"
        }
      }
    },
    "configGetData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "value",
        "source"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "bool",
            "integer",
            "string",
            "string_list",
            "bind"
          ]
        },
        "value": {
          "type": "string"
        },
        "source": {
          "enum": [
            "file",
            "default"
          ]
        }
      }
    },
    "envVariableView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "secret",
        "has_default",
        "source",
        "present"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "int",
            "bool",
            "url",
            "duration",
            "path"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "has_default": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "process",
            "default",
            "none"
          ]
        },
        "present": {
          "type": "boolean"
        }
      }
    },
    "envListData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "environment",
        "variables"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envVariableView"
          }
        }
      }
    },
    "envProblemView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "int",
            "bool",
            "url",
            "duration",
            "path"
          ]
        },
        "reason": {
          "enum": [
            "missing",
            "invalid_syntax",
            "not_unicode"
          ]
        }
      }
    },
    "envCheckData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "environment",
        "ok",
        "resolved_count",
        "problems"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "resolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envProblemView"
          }
        }
      }
    }
  }
}
