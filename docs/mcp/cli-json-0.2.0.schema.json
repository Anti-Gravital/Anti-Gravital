{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anti-gravital.dev/mcp/cli-json-0.2.0.schema.json",
  "title": "Anti-Gravital CLI versioned JSON output",
  "description": "Shape of `ag --output json` for read-only commands. RFC-0021 section 4.3 and RFC-0033. Pre-0.5 contract: unstable, any shape change bumps contract_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "command", "status"],
  "properties": {
    "contract_version": { "const": "0.2.0" },
    "command": {
      "enum": [
        "schema.lint",
        "schema.diff",
        "workers.list",
        "dns.plan",
        "dns.status",
        "unknown"
      ]
    },
    "status": { "enum": ["ok", "error"] },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/schemaLintData" },
        { "$ref": "#/$defs/schemaDiffData" },
        { "$ref": "#/$defs/workersListData" },
        { "$ref": "#/$defs/dnsPlanData" },
        { "$ref": "#/$defs/dnsStatusData" }
      ]
    },
    "error": { "$ref": "#/$defs/errorBody" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "required": ["data"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"] }
    }
  ],
  "$defs": {
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["unsupported_command", "read_failed"]
        },
        "message": { "type": "string" }
      }
    },
    "diagnosticView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message", "hint", "span_start", "span_end"],
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string" },
        "hint": { "type": ["string", "null"] },
        "span_start": { "type": "integer", "minimum": 0 },
        "span_end": { "type": "integer", "minimum": 0 }
      }
    },
    "schemaLintData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "result", "error_count", "warning_count", "diagnostics"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "result": { "enum": ["clean", "warnings", "errors"] },
        "error_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnosticView" }
        }
      }
    },
    "schemaChangeView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message"],
      "properties": {
        "severity": { "enum": ["breaking", "additive"] },
        "message": { "type": "string" }
      }
    },
    "schemaDiffData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "schema", "changes"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/schemaChangeView" }
        }
      }
    },
    "workerView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "queue", "mode", "concurrency", "input", "retry_max_attempts"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "queue": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "concurrency": { "type": ["integer", "null"], "minimum": 0 },
        "input": { "type": "array", "items": { "type": "string" } },
        "retry_max_attempts": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "workersListData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "workers"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "workers": {
          "type": "array",
          "items": { "$ref": "#/$defs/workerView" }
        }
      }
    },
    "dnsRecordView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "name", "value", "ttl", "is_ownership"],
      "properties": {
        "record_type": { "enum": ["A", "AAAA", "CNAME", "TXT", "MX"] },
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "ttl": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "is_ownership": { "type": "boolean" }
      }
    },
    "dnsPlanData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "domain",
        "zone",
        "environment",
        "visibility",
        "project",
        "service",
        "target_kind",
        "tls",
        "records",
        "notes"
      ],
      "properties": {
        "plan_id": { "type": "string", "pattern": "^dns-(dev|staging|production|local)-[0-9a-f]{16}$" },
        "domain": { "type": "string" },
        "zone": { "type": "string" },
        "environment": { "enum": ["dev", "staging", "production", "local"] },
        "visibility": { "enum": ["public", "private"] },
        "project": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["service"] },
        "tls": { "enum": ["disabled", "managed_http01", "managed_dns01"] },
        "records": { "type": "array", "items": { "$ref": "#/$defs/dnsRecordView" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dnsStatusData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "applied",
        "plan_id",
        "domain",
        "visibility",
        "provider",
        "record_count",
        "in_sync"
      ],
      "properties": {
        "environment": { "enum": ["dev", "staging", "production", "local"] },
        "applied": { "type": "boolean" },
        "plan_id": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "visibility": { "enum": ["public", "private", null] },
        "provider": { "type": ["string", "null"] },
        "record_count": { "type": "integer", "minimum": 0 },
        "in_sync": { "type": "boolean" }
      }
    }
  }
}
