# Plantilla de variables de entorno. Valores evidentemente de ejemplo (S-1/S-3).
# Nunca copies este archivo a .env con valores reales en el repositorio.

# Clave del proveedor del modelo (solo en el gestor de secretos del CI)
ANTHROPIC_API_KEY=cambiar-en-el-gestor-de-secretos
OPENAI_API_KEY=cambiar-en-el-gestor-de-secretos
GEMINI_API_KEY=cambiar-en-el-gestor-de-secretos

# Token del loop (GitHub App o PAT de granularidad fina, nunca en el repo)
KAIZEN_TOKEN=cambiar-en-el-gestor-de-secretos

# Variable de repo que activa los workflows programados (se pone en GitHub, no aquí)
KAIZEN_LOOP_ENABLED=0
