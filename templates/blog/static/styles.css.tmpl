:root {
  color-scheme: light dark;
}

body {
  font-family: system-ui, sans-serif;
  line-height: 1.6;
  margin: 0;
  padding: 2rem;
}

main { max-width: 48rem; margin: 0 auto; }

nav a { margin-right: 0.5rem; }

article {
  padding: 1rem 0;
  border-bottom: 1px solid rgba(127, 127, 127, 0.3);
}

article h2 { margin: 0 0 0.3rem; }
