[package]
name = "{{name}}-api"
version = "0.1.0"
edition = "2021"

# Interface layer: HTTP transport through ag-core. Depends inward on app and
# domain, never on infra and never on sqlx (RFC-0019 section 4.1).
[dependencies]
app = { package = "{{name}}-app", path = "../app" }
domain = { package = "{{name}}-domain", path = "../domain" }
ag-core = { git = "https://github.com/anti-gravital/anti-gravital", rev = "91a95ff61ed6ef4c9d3f1c9069357e97389d1382" }
axum = { version = "0.7", default-features = false, features = ["http1", "http2", "tokio", "json", "matched-path"] }
serde = { version = "1", features = ["derive"] }
tokio = { version = "1", features = ["net"] }
