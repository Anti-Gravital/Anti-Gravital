<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{name}}</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <span class="brand">{{name}}</span>
    <nav><a href="/about">About</a></nav>
  </header>

  <main>
    <section class="hero">
      <h1>Ship reliable backends, faster.</h1>
      <p>{{name}} is built on Anti-Gravital: a modular, observable Rust runtime
        with security enabled by default.</p>
      <a class="cta" href="/about">Learn more</a>
    </section>

    <section class="features">
      <h2>Why teams choose us</h2>
      <div class="grid">
        <article><h3>Secure by default</h3><p>Shield protects every route.</p></article>
        <article><h3>Composable</h3><p>Adopt only the crates you need.</p></article>
        <article><h3>Predictable</h3><p>Small binaries, explicit configuration.</p></article>
      </div>
    </section>

    <section class="cta-band">
      <h2>Ready to start?</h2>
      <p>Replace this copy with your product message.</p>
    </section>
  </main>
</body>
</html>
