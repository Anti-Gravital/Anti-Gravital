model User {
    id UUID @primary @auto
    email String @unique
}

request UpdateUser {
    email String @email
    username String @regex("^[a-z][a-z0-9_]{2,15}$")
}

response UserResponse {
    id UUID
    email String
}

endpoint UpdateUser {
    method PATCH
    path /users/{id}
    auth required
    body UpdateUser
    response UserResponse
}
